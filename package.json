{
  "name": "dsh-sub-providers",
  "version": "0.1.0",
  "description": "Clean-room DSH plugin: use Claude and ChatGPT (Codex) subscriptions as LLM provider routes with OAuth login, streaming, and subscription usage display.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deskomor/dsh-sub-providers.git"
  },
  "bugs": {
    "url": "https://github.com/deskomor/dsh-sub-providers/issues"
  },
  "homepage": "https://github.com/deskomor/dsh-sub-providers#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "claude",
    "codex",
    "oauth",
    "llm"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "security-scan": "node scripts/security-scan.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-brand": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.8.0"
  }
}
